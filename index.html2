<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>شهادة الصون للعلم</title>
<style>
  body {
    font-family: "Arial", sans-serif;
    background-color: #f0f0f0; /* light grey for screen background */
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
  }

  .certificate {
    position: relative;
    width: 90%;
    max-width: 1122px;  /* A4 landscape width in pixels at 96dpi */
    height: 792px;      /* A4 landscape height in pixels */
    border: 5px solid #d4af37; /* subtle gold border */
    background-color: #fff8e1; /* cream background */
    padding: 40px;
    box-sizing: border-box;
    text-align: center;
    margin-top: 20px;
  }

  .school-name {
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 20px;
  }

  .title {
    font-size: 24px;
    margin-bottom: 40px;
  }

  .content {
    font-size: 20px;
    line-height: 1.6;
  }

  .flag {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 80px;
  }

  /* Input section */
  .input-section {
    margin-top: 20px;
    text-align: center;
  }

  input[type="text"] {
    padding: 8px;
    font-size: 16px;
    width: 250px;
  }

  button {
    padding: 8px 16px;
    font-size: 16px;
    margin-left: 10px;
    cursor: pointer;
  }

  @media print {
    body, html {
      margin: 0;
      padding: 0;
      width: 297mm;
      height: 210mm;
    }
    .certificate {
      width: 297mm;
      height: 210mm;
      padding: 20mm;
      border: 5px solid #d4af37;
    }
    .input-section {
      display: none; /* hide input when printing */
    }
  }
</style>
</head>
<body>

<div class="input-section">
  <label for="nameInput">أدخل اسمك:</label>
  <input type="text" id="nameInput" placeholder="الاسم هنا">
  <button onclick="generateCertificate()">عرض الشهادة</button>
</div>

<div class="certificate" id="certificate">
  <!-- UAE Flag -->
  <img class="flag" src="https://upload.wikimedia.org/wikipedia/commons/c/ca/Flag_of_the_United_Arab_Emirates.svg" alt="UAE Flag">

  <!-- School Name -->
  <div class="school-name">مدرسة خليفة بن زايد</div>

  <!-- Certificate Title -->
  <div class="title">شهادة الصون للعلم</div>

  <!-- Certificate Content -->
  <div class="content" id="certificateContent">
    تتقدم مدرسة خليفة بن زايد بالشكر والتقدير إلى:<br><br>
    <strong>[أدخل الاسم هنا]</strong><br><br>
    لمشاركته في <strong>صون العلم وعلم دولة الإمارات العربية المتحدة</strong> من خلال الالتزام بالحفاظ على العلم وحمايته، والتعهد بصونه والاعتزاز به.
  </div>
</div>

<script>
  function generateCertificate() {
    const name = document.getElementById("nameInput").value.trim();
    if (name) {
      const content = document.getElementById("certificateContent");
      content.innerHTML = `
        تتقدم مدرسة خليفة بن زايد بالشكر والتقدير إلى:<br><br>
        <strong>${name}</strong><br><br>
        لمشاركته في <strong>صون العلم وعلم دولة الإمارات العربية المتحدة</strong> من خلال الالتزام بالحفاظ على العلم وحمايته، والتعهد بصونه والاعتزاز به.
      `;
    } else {
      alert("الرجاء إدخال الاسم.");
    }
  }
</script>

</body>
</html>
